<Page x:Class="AlalykinKP.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AlalykinKP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage" FontFamily="Courier New">

    <Grid>
        <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1000"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ФИО" FontSize="25" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Дата рождения" FontSize="25" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Должность" FontSize="25" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Награды" FontSize="25" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Участие" FontSize="25" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Рота" FontSize="25" Grid.Column="0" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBox Text="{Binding familya}" Width="250" Height="45" FontSize="25"></TextBox>
            <TextBox Text="{Binding imya}" Width="250" Height="45" FontSize="25"></TextBox>
            <TextBox Text="{Binding otchestvo}" Width="250" Height="45" FontSize="25"></TextBox>
        </StackPanel>
        <DatePicker Name="BirhDateDP" Grid.Row="1" Grid.Column="1" Height="45" Width="250" FontSize="25" HorizontalAlignment="Left"/>
        <TextBox Text="{Binding dolzhnost}" Grid.Column="1" Grid.Row="2" Height="45" Width="750" HorizontalAlignment="Left" FontSize="25"></TextBox>
        <TextBox Text="{Binding nagrady}" Grid.Column="1" Grid.Row="3" Height="45" Width="750" HorizontalAlignment="Left" FontSize="25"></TextBox>
        <TextBox Text="{Binding uchastie}" Grid.Column="1" Grid.Row="4" Height="45" Width="750" HorizontalAlignment="Left" FontSize="25"></TextBox>
        <ComboBox Name="RotaCombo" Grid.Column="1" Grid.Row="5" Height="45" Width="400" HorizontalAlignment="Left" FontSize="25">
            <TextBlock>мотострелковая рота</TextBlock>
            <TextBlock>танковая рота</TextBlock>
            <TextBlock>воздушно-десантная рота</TextBlock>
            <TextBlock>рота морской пехоты</TextBlock>
            <TextBlock>рота БПЛА</TextBlock>
        </ComboBox>
        <Button Name="SaveButton" Content="Сохранить" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Click="SaveButton_Click" FontSize="25" Width="250" Height="45"></Button>
        <Button HorizontalAlignment="Left" Name="name" Content="Выберите изображение" Height="45" Width="500" FontSize="25" VerticalAlignment="Center" Grid.Column="2" Click="ChangePhoto_Click"/>
        <Image Width="500" Grid.Column="2" Grid.RowSpan="4" Grid.Row="1" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Name="BigImage">
            <Image.Source>
                <Binding Path="image">
                    <Binding.TargetNullValue>
                        <ImageSource>
                            Images/not_found.png
                        </ImageSource>
                    </Binding.TargetNullValue>
                </Binding>
            </Image.Source>
        </Image>
    </Grid>
</Page>
